# Copy to .env and fill in. Every setting is listed in leadbot/config.py.

# ---------- Local demo (no accounts needed) ----------
# With these values the bot talks to scripts/fake_services.py instead of the real Slack, Clay and HubSpot.
# Start it with:  uv run uvicorn scripts.fake_services:app --port 8001
SLACK_SIGNING_SECRET=local-slack-secret
SLACK_BOT_TOKEN=xoxb-local
SLACK_BASE_URL=http://localhost:8001/slack
CLAY_WEBHOOK_URL=http://localhost:8001/clay/webhook
CLAY_CALLBACK_SECRET=local-clay-secret
HUBSPOT_TOKEN=local
HUBSPOT_BASE_URL=http://localhost:8001/hubspot
INTERNAL_SECRET=local-sweep-secret

# ---------- Real services (replace the block above) ----------
# SLACK_SIGNING_SECRET=        # Slack app > Basic Information > Signing Secret
# SLACK_BOT_TOKEN=xoxb-...     # Slack app > OAuth & Permissions (scopes: app_mentions:read, chat:write)
# SLACK_BASE_URL=https://slack.com/api
# SLACK_ALERT_CHANNEL="#lead-research-alerts"   # invite the bot to this channel
# CLAY_WEBHOOK_URL=            # Clay table > webhook source URL
# CLAY_WEBHOOK_TOKEN=          # only if the webhook source requires an auth token
# CLAY_CALLBACK_SECRET=        # any long random string; also set in the Clay HTTP API column (docs/clay-setup.md)
# HUBSPOT_TOKEN=pat-...        # HubSpot private app token (scopes in the README)
# HUBSPOT_BASE_URL=https://api.hubapi.com
# INTERNAL_SECRET=             # any long random string; also a GitHub Actions secret for the sweeper

# ---------- Model ----------
# With no key for either provider, no model is called and every brief comes from the template.

# Provider 1: any OpenAI-compatible endpoint. Used when LLM_API_KEY and LLM_MODEL are both set.
# NVIDIA NIM: get a key at build.nvidia.com and copy the model id from the model's page.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2000
# Optional JSON merged into each request, for example to turn off a model's hidden reasoning:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Provider 2: Claude. Used when ANTHROPIC_API_KEY is set and provider 1 is not.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=2000

# ---------- Database ----------
# Supabase > Project Settings > Database > Connection string (use the pooler, "Transaction" mode).
# Empty = in-memory store: fine for the local demo, but state is lost on restart.
DATABASE_URL=

# ---------- Who is selling (goes into the fact sheet) ----------
SELLER_NAME=Northwall
SELLER_PITCH="compliance automation for ISO 27001, SOC 2, GDPR and TISAX"
